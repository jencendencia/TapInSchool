# TapIn School — environment configuration.
# Copy this file to .env (gitignored) and edit for your machine.
#   cp .env.example .env

# ---- MySQL database (see NETWORK_DATABASE_CONNECTION.md) -------------------
# To share one database across every computer in the school, set DB_HOST to the
# LAN IP of the machine running MySQL (e.g. 192.168.1.129) and use a dedicated
# network account (never root). Each machine can also override these from the
# app's title bar → Connect to database — that saved connection wins over .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tapin_school

# ---- QR payload signing secret ----------------------------------------------
# ⚠️ Do NOT change this after enrolling students — it invalidates every printed
# QR code. Set your own secret BEFORE enrolling; the value below matches what
# the app uses when unset, so a fresh copy behaves exactly like an unconfigured
# install.
QR_SECRET=tapin-school-default-secret

# ---- SMS provider defaults (overridable live in Admin > Settings) ----------
SMS_PROVIDER=simulator            # simulator | gsm | cloud
# GSM_SERIAL_COM_PORT=COM3          # or /dev/ttyUSB0 on Linux
# CLOUD_PROVIDER=semaphore          # semaphore | messagebird | philsms | generic
# CLOUD_API_KEY=
# CLOUD_SENDER=

# ---- School identity used in SMS messages -----------------------------------
SCHOOL_NAME=TapIn School
