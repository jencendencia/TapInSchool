# ---- MySQL (required) -----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=tapin_school

# ---- QR payload signing secret (do NOT change after enrolling students) ---
QR_SECRET=tapin-change-me

# ---- SMS provider defaults (overridable live in Admin > Settings) ---------
# SMS_PROVIDER=simulator | gsm | cloud
SMS_PROVIDER=simulator
# GSM_SERIAL_COM_PORT=COM3          # or /dev/ttyUSB0 on Linux
# CLOUD_PROVIDER=semaphore | messagebird | generic
# CLOUD_API_KEY=
# CLOUD_SENDER=

# ---- School identity used in SMS messages ---------------------------------
SCHOOL_NAME=TapIn School
